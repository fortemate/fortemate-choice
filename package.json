{
	"name": "@fortemate/fortemate-choice",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Fortemate Choice: two dice pairs, one choice. A standalone Dice Chess client.",
	"license": "AGPL-3.0-only",
	"repository": {
		"url": "git+https://github.com/fortemate/fortemate-choice.git",
		"type": "git"
	},
	"engines": {
		"node": ">=26.12 <27"
	},
	"scripts": {
		"dev": "vite",
		"dev:laboratory": "vite --config vite.laboratory.config.ts",
		"build": "vite build",
		"postbuild": "node scripts/verify-laboratory-bundle.mjs",
		"build:laboratory": "vite build --config vite.laboratory.config.ts",
		"postbuild:laboratory": "node scripts/verify-laboratory-bundle.mjs",
		"preview": "vite preview --port 4175 --strictPort",
		"preview:laboratory": "vite preview --config vite.laboratory.config.ts --port 4175 --strictPort",
		"build:hosting": "cf build --mode cloudflare-preview",
		"build:closed-preview": "cf build --mode cloudflare-closed-preview",
		"build:release": "cf build --mode cloudflare-release",
		"preview:hosting": "vite preview --mode cloudflare-preview",
		"check:hosting": "tsc --project hosting/tsconfig.json",
		"test:hosting": "playwright test --config playwright.hosting.config.ts",
		"test:hosting:acceptance": "node scripts/hosting-preview/run.mjs",
		"check": "npm run lint && npm run format:check && npm run check:types",
		"check:types": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run && npm run test:laboratory:oracle && npm run test:laboratory:pilot:unit",
		"test:ci-policy": "node --test scripts/pr-policy.test.mjs scripts/ci-events.test.mjs",
		"test:choice:networks": "node --test scripts/choice-networks.test.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"test:e2e": "playwright test --config playwright.laboratory.config.ts",
		"test:laboratory": "playwright test --config playwright.laboratory.config.ts",
		"test:laboratory:oracle": "node --test scripts/laboratory-acceptance/*.test.mjs",
		"test:laboratory:acceptance": "node scripts/laboratory-acceptance/run.mjs",
		"test:laboratory:pilot:unit": "node --test scripts/laboratory-pilot/*.test.mjs",
		"test:laboratory:pilot": "node scripts/laboratory-pilot/run.mjs",
		"check:rules-version": "node --test scripts/verify-rules-version.test.mjs && node scripts/verify-rules-version.mjs"
	},
	"dependencies": {
		"@fortemate/dicechess-engine": "0.18.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.v.17",
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "2.25.2",
		"@playwright/test": "1.64.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"cf": "1.0.0-beta.32",
		"eslint": "10.15.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.12.0",
		"jsdom": "31.0.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.8.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"overrides": {
		"minimatch": "11.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
