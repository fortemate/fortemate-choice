{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node"],
		"paths": { "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src/**/*", "laboratory/**/*", "*.config.ts", "vitest-setup.ts"],
	"exclude": ["node_modules", "dist-laboratory", "coverage", "test-results"]
}
